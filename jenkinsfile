pipeline {
    agent any

    environment {
        # IMPORTANT: Store these credentials securely in Jenkins using 'Credentials'
        DB_USER = credentials('ORACLE_USER').username
        DB_PASS = credentials('ORACLE_USER').password
        DB_DSN = 'localhost:1521/XE' // Example DSN for Oracle XE
        APP_PATH = '/var/www/product-app' // Deployment directory on EC2
    }

    stages {
        stage('Checkout Code') {
            steps {
                # Clone the repository
                git url: 'YOUR_GITHUB_REPO_URL', branch: 'main'
            }
        }
        
        stage('Database Deployment (PL/SQL)') {
            steps {
                echo 'Deploying SQL and PL/SQL changes...'
                
                # 1. Run the Schema DDL (Idempotent - safe to run multiple times)
                sh "sqlplus ${env.DB_USER}/${env.DB_PASS}@${env.DB_DSN} @db/schema.sql"
                
                # 2. Deploy the PL/SQL Package
                sh "sqlplus ${env.DB_USER}/${env.DB_PASS}@${env.DB_DSN} @db/product_pkg.sql"
                
                echo 'Database objects updated successfully.'
            }
        }
        
        stage('Application Build & Deploy') {
            steps {
                echo 'Setting up Python environment and deploying app...'
                
                # 1. Create deployment directory (if it doesn't exist)
                sh "sudo mkdir -p ${env.APP_PATH}"
                
                # 2. Copy the new files to the application directory
                sh "sudo cp app.py ${env.APP_PATH}/"
                sh "sudo cp requirements.txt ${env.APP_PATH}/"
                
                # 3. Install Python dependencies (run once or when requirements change)
                sh "sudo pip3 install -r ${env.APP_PATH}/requirements.txt"

                # 4. Set environment variables for the application user
                # In a production setup, you'd use systemd or Docker for this
                sh "echo 'DB_USER=${env.DB_USER}' > ${env.APP_PATH}/.env"
                sh "echo 'DB_PASS=${env.DB_PASS}' >> ${env.APP_PATH}/.env"
                sh "echo 'DB_DSN=${env.DB_DSN}' >> ${env.APP_PATH}/.env"
            }
        }
        
        stage('Restart Application Service') {
            steps {
                echo 'Restarting Flask service to apply changes...'
                
                # NOTE: Use 'pkill' only for a simple example. For production, use 'systemctl' 
                # or a process manager like Gunicorn/Supervisor/PM2.
                
                # Command to restart the simple Flask app (if using a systemd service)
                sh "sudo systemctl restart product-app-flask.service" 
            }
        }
    }
}